CAPI=2:
name: ::i2c_master:1.0.0
description: Portable bounded I2C master with clock stretching and bus recovery

filesets:
  rtl:
    files:
      - src/i2c_master.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/i2c_master_tb.sv: {file_type: systemVerilogSource}
      - tb/test_i2c_master.py: {file_type: user}

targets:
  default: &default
    filesets: [rtl]
    toplevel: i2c_master

  sim:
    filesets: [rtl, sim]
    toplevel: i2c_master_tb
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    <<: *default
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
