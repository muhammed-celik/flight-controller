CAPI=2:
name: ::reset_sync:1.0.0
description: Asynchronous-assert, synchronous-release reset synchronizer

filesets:
  rtl:
    files:
      - src/reset_sync.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/test_reset_sync.py: {file_type: user}

targets:
  default: &default
    filesets: [rtl]
    toplevel: reset_sync

  sim:
    filesets: [rtl, sim]
    toplevel: reset_sync
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    <<: *default
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
