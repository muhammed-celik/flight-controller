CAPI=2:
name: ::sp_ram:1.0.0
description: Parametric single-port RAM with registered synchronous read

filesets:
  rtl:
    files:
      - src/sp_ram.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/sp_ram_tb.sv: {file_type: systemVerilogSource}
      - tb/cocotb_env.cpp: {file_type: cppSource, copyto: cocotb_env.cpp}
      - tb/test_sp_ram.py: {file_type: user, copyto: test_sp_ram.py}

targets:
  default:
    filesets: [rtl]
    toplevel: sp_ram

  sim:
    filesets: [rtl, sim]
    toplevel: sp_ram_tb
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_sp_ram
      mode: cc
      verilator_options:
        - --trace
        - -Wno-WIDTHEXPAND
        - -LDFLAGS "-Wl,--disable-new-dtags,-rpath,$$(dirname $$(cocotb-config --libpython))"
      run_options: [--trace, --trace-file, sp_ram.vcd]
