CAPI=2:
name: ::clock_reset:1.0.0
description: Cmod A7 system clock, MMCM lock qualification, and reset release

filesets:
  rtl:
    files:
      - src/fc_clock_reset.sv
    file_type: systemVerilogSource
    depend:
      - ::clk_gen:1.0.0
      - ::reset_sync:1.0.0

  sim:
    files:
      - tb/test_clock_reset.py: {file_type: user}
    depend:
      - ::xilinx_7series_sim:1.0.0

  constraints:
    files:
      - constraints/clock_reset.xdc
    file_type: xdc

targets:
  default: &default
    filesets: [rtl]
    toplevel: fc_clock_reset

  sim:
    filesets: [rtl, sim]
    toplevel: fc_clock_reset
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    <<: *default
    filesets: [rtl, constraints]
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
