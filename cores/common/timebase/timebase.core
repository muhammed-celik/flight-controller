CAPI=2:
name: ::timebase:1.0.0
description: Cycle timestamp and deterministic control-rate enables

filesets:
  rtl:
    files:
      - src/rate_enable.sv
      - src/fc_timebase.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/timebase_tb.sv: {file_type: systemVerilogSource}
      - tb/test_timebase.py: {file_type: user}

targets:
  default: &default
    filesets: [rtl]
    toplevel: fc_timebase

  sim:
    filesets: [rtl, sim]
    toplevel: timebase_tb
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    <<: *default
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
