CAPI=2:
name: ::clk_gen:1.0.0
description: MMCM clock generator for Xilinx 7-series (12 MHz to 100 MHz default)

filesets:
  rtl:
    files:
      - src/clk_gen.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/test_clk_gen.py: {file_type: user}
    depend:
      - ::xilinx_7series_sim:1.0.0

targets:
  default:
    filesets: [rtl]
    toplevel: clk_gen

  sim:
    filesets: [rtl, sim]
    toplevel: clk_gen
    default_tool: verilator
    tools:
      verilator:
        mode: cc
