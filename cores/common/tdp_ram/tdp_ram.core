CAPI=2:
name: ::tdp_ram:1.0.0
description: Parametric true dual-port RAM with two independent read/write ports

filesets:
  rtl:
    files:
      - src/tdp_ram.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/tdp_ram_tb.sv: {file_type: systemVerilogSource}
      - tb/cocotb_env.cpp: {file_type: cppSource, copyto: cocotb_env.cpp}
      - tb/test_tdp_ram.py: {file_type: user, copyto: test_tdp_ram.py}

targets:
  default:
    filesets: [rtl]
    toplevel: tdp_ram

  sim:
    filesets: [rtl, sim]
    toplevel: tdp_ram_tb
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_tdp_ram
      mode: cc
      verilator_options:
        - --trace
        - -Wno-WIDTHEXPAND
        - -LDFLAGS "-Wl,--disable-new-dtags,-rpath,$$(dirname $$(cocotb-config --libpython))"
      run_options: [--trace, --trace-file, tdp_ram.vcd]
