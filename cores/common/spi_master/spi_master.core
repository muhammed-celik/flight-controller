CAPI=2:
name: ::spi_master:1.0.0
description: SPI master

filesets:
  rtl:
    files:
      - src/spi_master_pkg.sv
      - src/spi_clk_gen.sv
      - src/spi_master.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/spi_master_tb.sv: {file_type: systemVerilogSource}
      - tb/cocotb_env.cpp: {file_type: cppSource, copyto: cocotb_env.cpp}
      - tb/test_spi_master.py: {file_type: user, copyto: test_spi_master.py}

targets:
  default:
    filesets: [rtl]
    toplevel: spi_master

  sim:
    filesets: [rtl, sim]
    toplevel: spi_master_tb
    flow: sim
    flow_options:
      tool: verilator
      cocotb_module: test_spi_master
      mode: cc
      verilator_options:
        - --trace
        - -Wno-WIDTHEXPAND
        - -LDFLAGS "-Wl,--disable-new-dtags,-rpath,$$(dirname $$(cocotb-config --libpython))"
      run_options: [--trace, --trace-file, spi_master.vcd]
