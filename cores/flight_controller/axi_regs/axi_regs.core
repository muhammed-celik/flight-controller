CAPI=2:
name: ::fc_axi_regs:1.0.0
description: Flight-controller AXI4-Lite global register bank

filesets:
  rtl:
    files:
      - src/coherent_snapshot.sv
      - src/shadow_commit.sv
      - src/axi_lite_slave.sv
      - src/fc_axi_regs.sv
    file_type: systemVerilogSource
    depend:
      - ::axi:1.0.0

  sim:
    files:
      - tb/test_fc_axi_regs.py: {file_type: user}

targets:
  default: &default
    filesets: [rtl]
    toplevel: fc_axi_regs

  sim:
    filesets: [rtl, sim]
    toplevel: fc_axi_regs
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    <<: *default
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
