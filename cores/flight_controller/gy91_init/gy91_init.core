CAPI=2:
name: ::gy91_init:1.0.0
description: Deterministic GY-91 sensor initialization and I2C register adapter

filesets:
  rtl:
    depend:
      - ::i2c_master:1.0.0
    files:
      - src/i2c_register_master.sv
      - src/gy91_init.sv
      - src/gy91_init_subsystem.sv
    file_type: systemVerilogSource

  sim:
    files:
      - tb/gy91_init_tb.sv: {file_type: systemVerilogSource}
      - tb/test_gy91_init.py: {file_type: user}

targets:
  default: &default
    filesets: [rtl]
    toplevel: gy91_init

  sim:
    filesets: [rtl, sim]
    toplevel: gy91_init_tb
    default_tool: verilator
    tools:
      verilator:
        mode: cc

  synth:
    filesets: [rtl]
    toplevel: gy91_init_subsystem
    default_tool: vivado
    tools:
      vivado:
        part: xc7a35tcpg236-1
        pnr: none
